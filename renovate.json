{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinDigests",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Automerge sicherer Updates nach bestandener CI",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Zusammengehörige Playwright-Tools gemeinsam aktualisieren",
      "matchPackageNames": ["@playwright/test", "playwright-bdd"],
      "groupName": "Playwright"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
