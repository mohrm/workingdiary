{
  "name": "workingdiary",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/update-version.mjs",
    "dev": "node --import tsx scripts/dev.ts",
    "build": "node --import tsx scripts/build.ts",
    "preview": "node --import tsx scripts/preview.ts",
    "prebuild": "npm run lint && node scripts/update-version.mjs",
    "pretest": "node scripts/update-version.mjs",
    "test": "sh scripts/run-tests.sh $(find src -name '*.spec.ts')",
    "test:watch": "node --import tsx --import ./test-setup.ts --experimental-test-coverage --watch --test $(find src -name '*.spec.ts')",
    "test:docker": "bash scripts/test-docker.sh",
    "pretypecheck": "node scripts/update-version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "e2e": "npx bddgen -c e2e/playwright.config.ts && npx playwright test -c e2e/playwright.config.ts",
    "e2e-prepare:ci": "npx playwright install --with-deps && npx bddgen -c e2e/playwright.config.ts",
    "e2e:ci": "npx playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "playwright-bdd": "9.2.0",
    "tsx": "4.23.8",
    "typescript": "7.0.2"
  }
}
